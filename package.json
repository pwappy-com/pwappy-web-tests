{
  "name": "pwappy-web-tests",
  "version": "1.0.0",
  "description": "E2E tests for pwappy-web",
  "scripts": {
    "test": "npx playwright test",
    "test:discovery": "node --test tests/tools/discovery-boundaries.check.cjs",
    "test:webmcp": "node tests/tools/webmcp/run-isolated.cjs",
    "test:webmcp:list": "node tests/tools/webmcp/run-isolated.cjs --list",
    "test:webmcp:firefox": "node tests/tools/webmcp/run-isolated.cjs --firefox-ui",
    "test:webmcp:checks": "node --test tests/tools/webmcp/isolation-options.check.cjs",
    "test:webmcp:staging": "node scripts/run-staging-native.mjs",
    "test:webmcp:pwa": "node tests/tools/webmcp/test-generated-pwa.cjs",
    "test:webmcp:pwa-installed": "node tests/tools/webmcp/test-installed-pwa.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.2",
    "dotenv": "^16.5.0"
  }
}
